# ==============================================================================
# FastAPI Backend Environment Variables
# ==============================================================================

# 1. LLM API Key (Required for voice listener, recommendations, and deck inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Server Port (Set automatically by cloud hosts like Render via $PORT)
PORT=8000

# 3. Allowed CORS Origins (Comma-separated list of origins, e.g. https://your-frontend.vercel.app)
# Default includes localhost:5173, https://localhost, and capacitor://localhost
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# 4. Optional: Hosted Database Connection (e.g. MongoDB Atlas or PostgreSQL)
# If omitted or offline, backend safely uses resilient in-memory storage.
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hackcache_db?retryWrites=true&w=majority
# DATABASE_URL=postgresql://user:pass@ep-hostname.region.aws.neon.tech/dbname?sslmode=require

# 5. Optional LLM Fallback (if using Mistral engine fallback)
MISTRAL_API_KEY=your_mistral_api_key_here
